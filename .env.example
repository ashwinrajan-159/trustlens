# ── TrustLens AI — environment template (copy to .env; .env is gitignored) ──

# App
APP_NAME=TrustLens AI
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (async — asyncpg driver)
DATABASE_URL=postgresql+asyncpg://trustlens:trustlens@localhost:5432/trustlens

# Security
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-use-a-64-char-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level PII encryption (Fernet) — dev only; use KMS/HSM in prod
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Object storage (MinIO dev / S3 prod)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=trustlens-documents
STORAGE_REGION=us-east-1
PRESIGNED_URL_TTL_SECONDS=900

# Redis / Celery (used from Phase 2)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
